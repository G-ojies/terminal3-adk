# Copy to .env and fill in. Run scripts with:  npx tsx --env-file=.env scripts/<name>.ts
# .env is gitignored — never commit real values.

# --- Tenant identity -------------------------------------------------------
# Claimed at https://www.terminal3.io/claim-page — SHOWN ONCE, save immediately.
T3N_API_KEY=

# --- Additional principals -------------------------------------------------
# The walkthrough's invoke step needs up to three separate credentials. The
# claim page issues one; see BUGS.md BUG-08.
# USER_KEY  stands in for the data owner whose profile placeholders resolve against.
# AGENT_KEY stands in for the agent calling on the user's behalf. If unset,
#           invoke.ts falls back to the documented self-call.
USER_KEY=
AGENT_KEY=

# --- Contract configuration ------------------------------------------------
# Endpoint the eligibility contract calls through http-with-placeholders.
# Its host must appear in the user's agent-auth grant or egress is denied.
VERIFIER_URL=
VERIFIER_API_KEY=

# Only needed to deploy the reference flight contract.
DUFFEL_API_KEY=
